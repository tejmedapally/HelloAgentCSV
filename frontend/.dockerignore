# Build context hygiene for frontend image
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
uv.lock

# Secrets — never copy into the image
.env
.env.*
!.env.example
*.pem
*.key
.streamlit/secrets.toml

# Local / IDE
.git/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp
.uv/

# Docs not needed at runtime
*.md
!README.md
