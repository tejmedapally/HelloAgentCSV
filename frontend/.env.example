# Backend base URL (no trailing slash)
BACKEND_URL=http://localhost:8000

# Must match backend BACKEND_API_KEY when that is set (sent as X-API-Key).
# BACKEND_API_KEY=change-me-long-random

# Shared UI password. When set, Streamlit shows a login form first.
# Leave empty to skip the login gate (local/dev).
# APP_PASSWORD=share-with-graders-only

# Optional Streamlit settings
# STREAMLIT_SERVER_PORT=8501
