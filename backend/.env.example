# Anthropic Claude API (backend only — never commit real keys)
ANTHROPIC_API_KEY=

# Shared secret for API access (same value as frontend BACKEND_API_KEY).
# When set, clients must send header X-API-Key. Leave empty for open local API.
# BACKEND_API_KEY=change-me-long-random

# Optional model overrides
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LLM_TEMPERATURE=0

# CSV upload / preview
# PREVIEW_ROW_COUNT=5
# MAX_UPLOAD_SIZE_MB=10

# Server
# HOST=0.0.0.0
# PORT=8000
